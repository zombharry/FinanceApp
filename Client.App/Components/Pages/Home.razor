@page "/"

@attribute [Authorize]
@rendermode InteractiveServer
@inject JwtAuthenticationStateProvider _authStateProvider
@inject AccessTokenService _accessTokenService
@inject NavigationManager _navigationManager
@inject AuthService _authService
@inject ResourceService _resourceService


<PageTitle>Home</PageTitle>
<h1> You are authorizer <button class="btn btn-primary" @onclick="Logout">Logout</button></h1>

<table>
    <tr>
        <td>Username</td>
        <td>@Username</td>
    </tr>
        <tr>
            <td>Token</td>
            <td>@Token</td>
        </tr>
        <tr>
            <td>Token Expires At</td>
            <td>@TokenExpiresAt</td>
        </tr>
        <tr>
            <td>Current Time</td>
            <td>@CurrentTime</td>
        </tr>

</table>


<button class="btn btn-success mt-2" @onclick="VerifyGetRequest">Verify</button>
<h1 class="text-success mt-2">
    @if (IsVerified == true)
    {
        <span>Success!</span>
    }
    else if (IsVerified == false)
    {
        <span>Failed!</span>
    }
</h1>

@code {
    public string Username { get; set; }
    public string Token { get; set; }
    public DateTime TokenExpiresAt { get; set; }
    public DateTime CurrentTime { get; set; }
    public bool IsVerified { get; set; }

    private Timer timer;
    private bool _initialized = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_initialized)
        {
            _initialized = true;
            await InitialValues();
            timer = new Timer(UpdateClock, null, 0, 1000);
            StateHasChanged();
        }
    }

    private async Task InitialValues()
    {
        var state = await _authStateProvider.GetAuthenticationStateAsync();
        var user = state.User;
        if (user.Identity.IsAuthenticated)
        {
            Token = await _accessTokenService.GetAccessTokenAsync();
            var givenName = user.FindFirst("given_name")?.Value;
            Username = givenName;

            var expires = user.Claims.FirstOrDefault(x => x.Type == JwtRegisteredClaimNames.Exp).Value;
            if (long.TryParse(expires, out var exp))
            {
                TokenExpiresAt = DateTimeOffset.FromUnixTimeSeconds(exp).LocalDateTime;
            }

        }
        else
        {
            _navigationManager.NavigateTo("/login");
        }
    }

    private async Task Logout()
    {
        await _authService.LogOut(Username);
    }

    private async Task VerifyGetRequest()
    {
        IsVerified = await _resourceService.Verify();
        await InitialValues();
    }

    private void UpdateClock(object state)
    {
        CurrentTime = DateTime.Now;
        InvokeAsync(StateHasChanged);
    }
}