@page "/login"
@layout EmptyLayout


<div class="container">
    <form method="post" action="/signin">
        <input type="hidden" name="returnUrl" value="@ReturnUrl" />
        <input type="text" name="username" class="form-control" placeholder="Username" required autofocus />
        <input type="password" name="password" class="form-control" placeholder="Password" required />
        <button type="submit" class="btn btn-lg btn-primary btn-block w-100">Sign in</button>
    </form>

    @if (!string.IsNullOrEmpty(Error))
    {
        <p class="text-danger mt-2">Username or password was incorrect.</p>
    }

    <a href="/register" class="btn btn-lg btn-primary btn-block w-100 mt-2">Register a new account</a>
</div>

@code {
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }
}